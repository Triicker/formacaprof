{
  "name": "formacaprof-api",
  "version": "0.1.0",
  "private": true,
  "description": "API da plataforma Formação para Professores (Ética Editora)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:dev": "node --env-file-if-exists=.env dist/src/scripts/seed-dev.js",
    "admin:bootstrap": "node --env-file-if-exists=.env dist/src/scripts/bootstrap-admin.js",
    "db:local": "node scripts/local-postgres.mjs",
    "start:local": "node --env-file=.env dist/src/main.js",
    "start:migrate": "prisma migrate deploy && node dist/src/main.js",
    "seed:content": "node --env-file-if-exists=.env dist/src/scripts/seed-content.js",
    "seed:qa": "node --env-file-if-exists=.env dist/src/scripts/seed-qa.js",
    "midia:r2": "node --env-file-if-exists=.env dist/src/scripts/midia-r2.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "5.4.2",
    "deepmerge-ts": "^8.0.2"
  }
}
