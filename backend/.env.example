# ---------------------------------------------------------------------------
# API Formação para Professores — variáveis de ambiente
# Copie para .env apenas em desenvolvimento local. Em staging/produção,
# configure no painel do Render (nunca versione segredos).
# ---------------------------------------------------------------------------

# development | test | staging | production
NODE_ENV=development
PORT=3000

# Banco local: `npm run db:local` sobe um PostgreSQL em localhost:5433 sem Docker.
# No Render, vem do banco gerenciado (connectionString interna).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/formacaprof_dev"

# URL pública do frontend (links de convite e de redefinição de senha).
APP_URL=http://localhost:5173
# Origens aceitas no cabeçalho Origin das escritas (padrão: origem de APP_URL). Separe por vírgula.
# APP_ORIGINS=https://formacaprof.pages.dev,https://formacao.eticaeditora.com.br

# Só use se o frontend chamar a API em outro domínio SEM o proxy /api (não recomendado).
# CORS_ORIGINS=

# Atrás do proxy do Cloudflare Pages + balanceador do Render: 2. Local: vazio.
TRUST_PROXY=
# Segredo compartilhado com o proxy do Pages (>= 32 caracteres). Com ele, a API recusa acesso direto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SECRET=

# Cookies "Secure" (obrigatório em staging/produção; o nome passa a ser __Host-fp_session).
COOKIE_SECURE=false

SESSION_TTL_HOURS=72
INVITE_TTL_HOURS=168
RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
# Documentação em /api/docs (desligada por padrão em produção).
SWAGGER_ENABLED=true

# E-mail: log (só desenvolvimento: imprime os links no console) | smtp
MAIL_DRIVER=log
MAIL_FROM="Formação para Professores <nao-responda@eticaeditora.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Arquivos protegidos (PDFs etc.) servidos por /api/v1/media/:id. Padrão: ./storage
# STORAGE_DIR=
# Catálogo importado por `npm run seed:content`. Padrão: ./content/catalog.json
# CONTENT_FILE=

# Somente para `npm run admin:bootstrap` (defina na hora, não deixe salvo).
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# Somente para `npm run seed:dev` (desenvolvimento).
# DEMO_PASSWORD=professor123
